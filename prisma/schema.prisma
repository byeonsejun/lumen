// LUMEN 2차 — 회원 · 장바구니 · 주문. 상품은 DB 에 없다(src/catalog). 가격은 서버가 카탈로그로 다시 계산한다
// 일시는 timestamptz

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  KAKAO
  GOOGLE
  DEMO
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}

model User {
  id             String       @id @default(uuid(7)) @db.Uuid
  provider       AuthProvider
  providerUserId String
  name           String?
  createdAt      DateTime     @default(now()) @db.Timestamptz
  cartItems      CartItem[]
  orders         Order[]

  @@unique([provider, providerUserId])
  @@index([provider, createdAt])
}

model CartItem {
  userId      String   @db.Uuid
  productSlug String
  /// 고른 색 id. "" = 원래 색 (색 옵션이 없는 상품도 "")
  color       String   @default("")
  quantity    Int
  /// 담은 순서 — 목록은 이 순서로 보여 준다(수량을 바꿔도 줄이 움직이지 않게)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, productSlug, color])
}

model Order {
  /// 토스 orderId 겸용 — "LM" + 영숫자 20자
  id               String      @id
  userId           String      @db.Uuid
  status           OrderStatus @default(PENDING)
  totalKRW         Int
  orderName        String
  recipientName    String
  recipientPhone   String
  recipientAddress String
  paymentKey       String?
  method           String?
  paidAt           DateTime?   @db.Timestamptz
  createdAt        DateTime    @default(now()) @db.Timestamptz
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items            OrderItem[]

  @@index([userId, status, createdAt])
}

model OrderItem {
  id                 String  @id @default(uuid(7)) @db.Uuid
  orderId            String
  productSlug        String
  /// 고른 색 id ("" = 원래 색) · 주문 당시 색 이름
  color              String  @default("")
  colorLabelSnapshot String?
  nameSnapshot       String
  priceSnapshotKRW   Int
  quantity           Int
  order              Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}
